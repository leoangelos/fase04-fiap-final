# Copie este arquivo para .env e preencha com as chaves do portal Azure.
# Instruções de criação dos recursos: ver seção "Configuração do Azure" no README.

# Recurso "Speech service" (Fala) — tier F0 gratuito
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Recurso "Language service" (Análise de Texto) — tier F0 gratuito
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com/

# ── Camada hospitalar (API + workers) — opcional; sem estas chaves o
#    dashboard/pipeline multimodal continuam funcionando normalmente ──

# Supabase (schema 'hospital'; service key SOMENTE no backend/workers)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Redis (Upstash) — janela deslizante dos sinais vitais (z-score).
# Sem REDIS_URL, a janela é mantida em memória do processo (demo/testes).
REDIS_URL=
